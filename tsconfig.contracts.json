{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "isolatedModules": true, "skipLibCheck": true,
    "lib": ["ES2022"]
  },
  "include": ["contracts/**/*.ts", "shared/**/*.ts"]
}
